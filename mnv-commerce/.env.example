NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
# Only a NEW, independently verified MNV database. Never repoint this at Vendure.
DB_NAME=mnv_commerce_dev
DB_USER=mnv_runtime
DB_PASSWORD=replace-with-a-local-runtime-secret
DB_SCHEMA=public
DB_POOL_SIZE=10
LOG_LEVEL=info
# Explicit migration commands only; omit these entirely from the runtime environment.
DB_MIGRATION_USER=mnv_migrator
DB_MIGRATION_PASSWORD=replace-with-a-local-migration-secret
# Rollback is disabled by default. Only a disposable-test database can be confirmed.
# MNV_ALLOW_DESTRUCTIVE_ROLLBACK=mnv_commerce_test_unique_suffix

# Phase 3 server-owned pricing and fulfillment policy. Minor units are decimal integers.
COMMERCE_CURRENCY=INR
COMMERCE_TAX_BPS=0
COMMERCE_SHIPPING=0
COMMERCE_RESERVATION_SECONDS=900
COMMERCE_STOCK_LOCATION_CODE=MAIN

# Phase 4: sessions expire after 8 hours. No default administrator or client-controlled role.
# Provision administrators interactively with npm run admin:create using owner credentials.
# Serve credentials over HTTPS; exclude Authorization/Cookie/body/response tokens from proxy logs.
