# Allowlist source/build inputs; no local environment, dependencies or data.
**
!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**
!LICENSE.md
!NOTICE.md
!license/
!license/**

# Sensitive material stays excluded even if accidentally placed under src/.
**/.env
**/.env.*
**/.npmrc
**/.pgpass
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.sql
**/*.dump
**/*.backup
**/*.bak
**/*.db
**/*.db-*
**/*.sqlite*
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/backup/**
**/backups/**
**/mnv-commerce-backups/**
**/postgres-data/**
**/.pgdata/**
